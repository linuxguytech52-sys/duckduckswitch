{
  "manifest_version": 3,
  "name": "Google to DuckDuckGo Redirector",
  "version": "1.0.0",
  "description": "Automatically redirects Google searches to DuckDuckGo",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "google-to-duckduckgo-redirector@linuxguytech52",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "options_page": "options.html",
  "background": {
    "scripts": ["background-firefox.js"],
    "type": "module"
  }
}
